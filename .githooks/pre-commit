#!/usr/bin/env bash
# Verifie le formatage clang-format des fichiers C++ indexes avant chaque commit.
set -euo pipefail

files=$(git diff --cached --name-only --diff-filter=ACMR -- '*.cpp' '*.h' '*.hpp' || true)
[ -z "$files" ] && exit 0

if ! command -v clang-format > /dev/null; then
    echo "pre-commit: clang-format introuvable, verification ignoree." >&2
    exit 0
fi

status=0
for f in $files; do
    if ! clang-format --dry-run --Werror "$f" 2> /dev/null; then
        echo "pre-commit: $f n'est pas formate (clang-format -i $f)" >&2
        status=1
    fi
done
exit $status
